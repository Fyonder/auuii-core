{
  "id": "gobyAvisosRobo01",
  "name": "Goby: avisos do robô (fila e reservas)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "name": "A cada minuto",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "a7150b0b-0000-4a00-9000-000000000001"
    },
    {
      "parameters": {
        "url": "={{ $env.ROBO_GOBY_URL || 'https://emcynyuzuafovconujwo.supabase.co/functions/v1/robo-goby' }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "rota",
              "value": "avisos"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ROBO_GOBY_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "name": "Robô: avisos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "onError": "continueRegularOutput",
      "notesInFlow": true,
      "notes": "cada aviso vem uma vez só",
      "id": "a7150b0b-0000-4a00-9000-000000000002"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "tem1",
              "leftValue": "={{ $json.ok === true && Array.isArray($json.avisos) && $json.avisos.length > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Tem aviso?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "id": "a7150b0b-0000-4a00-9000-000000000003"
    },
    {
      "parameters": {
        "fieldToSplitOut": "avisos",
        "options": {}
      },
      "name": "Um item por aviso",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        -20
      ],
      "id": "a7150b0b-0000-4a00-9000-000000000004"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/goby",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: String($json.telefone || '').replace(/\\D/g, ''), text: String($json.mensagem || '') }) }}",
        "options": {
          "timeout": 20000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 3000
            }
          },
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "name": "Manda no WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -20
      ],
      "onError": "continueRegularOutput",
      "notesInFlow": true,
      "notes": "um por vez, 3 s entre eles; texto como veio",
      "id": "a7150b0b-0000-4a00-9000-000000000006"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ROBO_GOBY_URL || 'https://emcynyuzuafovconujwo.supabase.co/functions/v1/robo-goby' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ROBO_GOBY_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify((Number($json.statusCode) >= 200 && Number($json.statusCode) < 300 && !$json.error) ? { rota: 'aviso_resultado', id: $('Um item por aviso').all()[$itemIndex].json.id, ok: true } : { rota: 'aviso_resultado', id: $('Um item por aviso').all()[$itemIndex].json.id, ok: false, erro: (() => { const b = $json.body || {}; const m = $json.error?.message || $json.error || b.response?.message || b.message || b.error; const a = $('Um item por aviso').all()[$itemIndex].json; if (!String(a.telefone || '').replace(/\\D/g, '')) return 'aviso sem telefone'; if (!String(a.mensagem || '').trim()) return 'aviso sem mensagem'; return String(typeof m === 'string' ? m : JSON.stringify(m || '') || ('HTTP ' + $json.statusCode)).slice(0, 300); })() }) }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "name": "Robô: confirma",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        -20
      ],
      "onError": "continueRegularOutput",
      "notesInFlow": true,
      "notes": "aviso_resultado (enviado ou o erro)",
      "id": "a7150b0b-0000-4a00-9000-000000000008"
    }
  ],
  "connections": {
    "A cada minuto": {
      "main": [
        [
          {
            "node": "Robô: avisos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Robô: avisos": {
      "main": [
        [
          {
            "node": "Tem aviso?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tem aviso?": {
      "main": [
        [
          {
            "node": "Um item por aviso",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Um item por aviso": {
      "main": [
        [
          {
            "node": "Manda no WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manda no WhatsApp": {
      "main": [
        [
          {
            "node": "Robô: confirma",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all",
    "saveExecutionProgress": true
  },
  "pinData": {}
}
