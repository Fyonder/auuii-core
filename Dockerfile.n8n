# ==========================================================
#  AUUII CORE — n8n para o Render
#
#  Nao construimos nada: so damos ao Render um Dockerfile
#  apontando para a imagem oficial. O build vira um pull de
#  poucos segundos, e ENTRYPOINT/CMD/USER vem tudo da imagem.
#
#  Existe porque o runtime Docker do Render exige um
#  Dockerfile mesmo quando a imagem ja esta pronta.
#  Na VPS isso nao e usado: la o docker-compose puxa a
#  imagem direto.
#
#  Puxamos do Docker Hub (n8nio/n8n), nao de docker.n8n.io
#  como no compose: o registry proprio da n8n devolve
#  429 Too Many Requests para os IPs de build do Render.
#  E a mesma imagem, publicada nos dois lugares.
# ==========================================================
FROM n8nio/n8n:latest
