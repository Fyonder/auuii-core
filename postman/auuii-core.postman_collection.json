                "{{n8nUrl}}"
              ],
              "path": [
                "webhook",
                "auuii"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"messages.upsert\",\n  \"instance\": \"auuii\",\n  \"data\": {\n    \"key\": {\n      \"remoteJid\": \"5511990000001@s.whatsapp.net\",\n      \"fromMe\": false,\n      \"id\": \"POSTMAN-TESTE-001\"\n    },\n    \"pushName\": \"Teste Postman\",\n    \"message\": {\n      \"conversation\": \"qual minha posicao na fila?\"\n    },\n    \"messageType\": \"conversation\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Mesmo payload que a Evolution API manda no evento messages.upsert. Passa pelo filtro de eco e, como canal = whatsapp, a resposta e enviada pela Evolution (instancia precisa estar conectada). O HTTP devolve o retorno do sendText."
          }
        },
