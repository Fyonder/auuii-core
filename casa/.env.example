# ==========================================================
#  CASA — configuração dos serviços do PC de casa
#  Copie para .env. Não versione o .env.
# ==========================================================

# Pasta compartilhada. O Samba e o File Browser apontam
# para ela. Use um caminho absoluto que já exista.
PASTA_ARQUIVOS=/srv/arquivos

# Dono dos arquivos. Veja o seu com:  id -u  e  id -g
# Precisa ser o mesmo usuário que você cadastrar no Samba,
# senão um grava e o outro não consegue apagar.
PUID=1000
PGID=1000

# Porta do File Browser no host.
# Evite 80 (AdGuard), 5678 (n8n) e 8080 (Evolution).
FILEBROWSER_PORT=8082
