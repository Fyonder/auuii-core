# ==========================================================
#  AUUII CORE — variáveis de ambiente
#  Copie para .env e preencha. NUNCA versione o .env.
#
#  Gerar segredos fortes:
#    openssl rand -hex 32
# ==========================================================

# ---------- Banco de dados (postgres interno da Evolution) ----------
# Usuario e banco sao fixos no compose: evolution / evolution.
# Aqui vai so a senha.
EVOLUTION_DB_PASSWORD=troque-esta-senha

# ---------- Chaves ----------
# Chave global da Evolution API (header: apikey)
AUTHENTICATION_API_KEY=troque-esta-chave
# Criptografa as credenciais salvas no n8n. Se mudar, perde as credenciais.
N8N_ENCRYPTION_KEY=troque-esta-chave-de-32-bytes

# ---------- Domínios (produção / VPS) ----------
N8N_DOMAIN=n8n.auuii.com
EVOLUTION_DOMAIN=evo.auuii.com
ACME_EMAIL=voce@auuii.com

# URLs públicas usadas pelos webhooks.
# LOCAL:  http://localhost:5678  /  http://localhost:8080
# VPS:    https://${N8N_DOMAIN}  /  https://${EVOLUTION_DOMAIN}
N8N_PUBLIC_URL=http://localhost:5678
EVOLUTION_PUBLIC_URL=http://localhost:8080
N8N_HOST=localhost
N8N_PROTOCOL=http

# ---------- Portas expostas no host (modo local) ----------
# O postgres nao e exposto: so existe dentro da rede auuii-net.
N8N_PORT=5678
EVOLUTION_PORT=8080

# ---------- Backend da Auuii (tools do agente) ----------
# Base do backend que o agente consulta (rotas /api/suporte/*).
#   producao:            https://ifood.onrender.com
#   backend na sua maquina, visto pelo n8n no Docker: http://host.docker.internal:3002
# Nao existe API dentro desta stack: a API de negocio e a sua, hospedada.
AUUII_API_URL=https://ifood.onrender.com
# Mesmo valor de SUPORTE_API_KEY no Render (header x-suporte-api-key). Gere com: openssl rand -hex 32
AUUII_API_TOKEN=
# Telefones reais (so digitos, com DDI+DDD) usados por ./testar.sh api para bater nas rotas
TESTE_TEL_CLIENTE=
TESTE_TEL_MOTOBOY=
TESTE_TEL_LOJA=

# ---------- Agente ----------
# Nome da instancia criada na Evolution
EVOLUTION_INSTANCE=auuii
# Numero que recebe os avisos de handoff (so digitos, com DDI+DDD)
SUPORTE_WHATSAPP=

# ---------- Versões das imagens ----------
EVOLUTION_TAG=latest
N8N_TAG=latest

# ---------- Geral ----------
TZ=America/Sao_Paulo
N8N_EXECUTIONS_MAX_AGE_HOURS=336

# ==========================================================
#  Evolution API — demais configurações
#  (DATABASE_CONNECTION_URI e SERVER_URL sao montadas
#   automaticamente no docker-compose.yml)
# ==========================================================
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange

DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true

# Sem container redis nesta stack: a Evolution usa cache local.
CACHE_REDIS_ENABLED=false
CACHE_LOCAL_ENABLED=true

CONFIG_SESSION_PHONE_VERSION=2.3000.1015901307
LOG_LEVEL=ERROR
LOG_BAILEYS=error
